                                weight_transcr=weight_transcr,weight_spatial=weight_spatial,
                                ct_props=ct_props,
                                par_eta1=par_eta1)

                        # SpaDecoder-SingleCell (initialized with SpaDecoder-Cluster)
                        deconv_st1_sc, cell_wts_sc   = spadecoder_slice_wrapper(adata_spa, 
